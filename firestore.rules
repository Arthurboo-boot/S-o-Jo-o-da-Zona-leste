rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['id', 'name', 'location', 'rating', 'stars', 'comment', 'createdAt'])
        && data.keys().size() == 7
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.location is string && data.location.size() <= 100
        && (data.rating == 'bom' || data.rating == 'regular' || data.rating == 'ruim')
        && (data.stars is int || data.stars is float) && data.stars >= 1 && data.stars <= 5
        && data.comment is string && data.comment.size() <= 1000
        && data.createdAt is string && data.createdAt.size() <= 128;
    }

    match /feedbacks/{feedbackId} {
      allow read, list: if true;
      allow create: if isValidId(feedbackId) && isValidFeedback(incoming());
      allow update: if false; // Feedbacks are immutable once submitted
      allow delete: if true;  // Simple delete supported for the administrative client function
    }
  }
}
